<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Бизнес-процесс: обслуживание гостей"
            android:textSize="18sp" android:textStyle="bold" android:textColor="#1565C0"
            android:paddingBottom="16dp"/>

        <!-- Step helper via styled views -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <TextView android:layout_width="36dp" android:layout_height="36dp"
                android:text="1" android:gravity="center" android:textStyle="bold"
                android:textColor="#FFFFFF" android:background="#1565C0"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Гости садятся за стол" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Официант на схеме зала нажимает на столик и открывает заказ. Указывает количество гостей." android:textSize="13sp" android:textColor="#616161"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="2dp" android:layout_height="16dp" android:background="#9E9E9E" android:layout_marginStart="17dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <TextView android:layout_width="36dp" android:layout_height="36dp"
                android:text="2" android:gravity="center" android:textStyle="bold"
                android:textColor="#FFFFFF" android:background="#1565C0"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Принятие заказа" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Официант открывает меню, выбирает блюда по гостям, добавляет комментарии (без лука, аллергия и т.д.)." android:textSize="13sp" android:textColor="#616161"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="2dp" android:layout_height="16dp" android:background="#9E9E9E" android:layout_marginStart="17dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <TextView android:layout_width="36dp" android:layout_height="36dp"
                android:text="3" android:gravity="center" android:textStyle="bold"
                android:textColor="#FFFFFF" android:background="#1976D2"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Передача на кухню / бар" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Заказ зафиксирован в системе. Кухня получает задание. Официант отслеживает статус на экране отдачи." android:textSize="13sp" android:textColor="#616161"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="2dp" android:layout_height="16dp" android:background="#9E9E9E" android:layout_marginStart="17dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <TextView android:layout_width="36dp" android:layout_height="36dp"
                android:text="4" android:gravity="center" android:textStyle="bold"
                android:textColor="#FFFFFF" android:background="#1976D2"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Подача блюд" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Официант отмечает позиции как поданные (isServed = true). Гости могут дозаказывать блюда в тот же заказ." android:textSize="13sp" android:textColor="#616161"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="2dp" android:layout_height="16dp" android:background="#9E9E9E" android:layout_marginStart="17dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <TextView android:layout_width="36dp" android:layout_height="36dp"
                android:text="5" android:gravity="center" android:textStyle="bold"
                android:textColor="#FFFFFF" android:background="#2E7D32"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Закрытие счёта" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Официант закрывает заказ. Система автоматически считает итоговую сумму и переводит заказ в статус CLOSED." android:textSize="13sp" android:textColor="#616161"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="2dp" android:layout_height="16dp" android:background="#9E9E9E" android:layout_marginStart="17dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="36dp" android:layout_height="36dp"
                android:text="6" android:gravity="center" android:textStyle="bold"
                android:textColor="#FFFFFF" android:background="#37474F"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Аналитика" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Закрытые заказы попадают в историю. Данные отображаются в статистике: выручка, популярные блюда, загруженность столиков." android:textSize="13sp" android:textColor="#616161"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
